-- =========================================================================
-- SCRIPT COMPLETO DE LA FASE 1 - SISTEMA DE GESTIÓN DE GANADO
-- =========================================================================

-- 1. Tabla País (Configuración regional)
CREATE TABLE pais (
    codigo VARCHAR(10) PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    idioma VARCHAR(50) NOT NULL,
    moneda VARCHAR(50) NOT NULL,
    unidad_peso VARCHAR(20) NOT NULL,
    unidad_superficie VARCHAR(20) NOT NULL,
    formato_fecha VARCHAR(20) NOT NULL,
    zona_horaria VARCHAR(50) NOT NULL,
    franja_precio_codigo VARCHAR(10) NOT NULL,
    fecha_creacion TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    actualizado_en TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    actualizado_por VARCHAR(36),
    eliminado BOOLEAN DEFAULT FALSE
);

-- 2. Tabla FranjaPrecio (Configuración de precios por región)
CREATE TABLE franja_precio (
    codigo VARCHAR(10) PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    multiplicador NUMERIC(5, 2) NOT NULL,
    fecha_creacion TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    actualizado_en TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    actualizado_por VARCHAR(36),
    eliminado BOOLEAN DEFAULT FALSE
);

-- Agregar la llave foránea de País hacia FranjaPrecio
ALTER TABLE pais 
ADD CONSTRAINT fk_pais_franja_precio 
FOREIGN KEY (franja_precio_codigo) REFERENCES franja_precio(codigo);

-- 3. Tabla Usuario (Identidad global de la persona en la plataforma)
CREATE TABLE usuario (
    id VARCHAR(36) PRIMARY KEY,
    nombre VARCHAR(150) NOT NULL,
    correo VARCHAR(150) UNIQUE NOT NULL,
    contrasena_hash VARCHAR(255) NOT NULL,
    debe_cambiar_contrasena BOOLEAN DEFAULT TRUE,
    correo_verificado BOOLEAN DEFAULT FALSE,
    estado VARCHAR(50) DEFAULT 'activo',
    fecha_creacion TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    actualizado_en TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    actualizado_por VARCHAR(36),
    eliminado BOOLEAN DEFAULT FALSE
);

-- 4. Tabla Rancho (Unidad principal del sistema)
CREATE TABLE rancho (
    id VARCHAR(36) PRIMARY KEY,
    nombre VARCHAR(150) NOT NULL,
    departamento VARCHAR(100) NOT NULL,
    localidad VARCHAR(100) NOT NULL,
    latitud NUMERIC(10, 8),
    longitud NUMERIC(11, 8),
    superficie NUMERIC(10, 2) NOT NULL,
    tipo_produccion VARCHAR(50) NOT NULL,
    pais_codigo VARCHAR(10) NOT NULL,
    propietario_id VARCHAR(36) NOT NULL,
    fecha_creacion TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    actualizado_en TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    actualizado_por VARCHAR(36),
    eliminado BOOLEAN DEFAULT FALSE,
    CONSTRAINT fk_rancho_pais FOREIGN KEY (pais_codigo) REFERENCES pais(codigo),
    CONSTRAINT fk_rancho_propietario FOREIGN KEY (propietario_id) REFERENCES usuario(id)
);

-- 5. Tabla Módulo (Módulos funcionales del sistema sobre los que se otorgan permisos)
CREATE TABLE modulo (
    codigo VARCHAR(50) PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    fecha_creacion TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    actualizado_en TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    actualizado_por VARCHAR(36),
    eliminado BOOLEAN DEFAULT FALSE
);

-- 6. Tabla TipoColaborador (Tipos predefinidos o personalizados de colaboradores)
CREATE TABLE tipo_colaborador (
    id VARCHAR(36) PRIMARY KEY,
    rancho_id VARCHAR(36), -- Nulo si es un tipo predefinido global del sistema
    nombre VARCHAR(100) NOT NULL,
    es_predefinido BOOLEAN DEFAULT FALSE,
    fecha_creacion TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    actualizado_en TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    actualizado_por VARCHAR(36),
    eliminado BOOLEAN DEFAULT FALSE,
    CONSTRAINT fk_tipo_colaborador_rancho FOREIGN KEY (rancho_id) REFERENCES rancho(id)
);

-- 7. Tabla Membresía (Vínculo entre un usuario y un rancho con su rol)
CREATE TABLE membresia (
    id VARCHAR(36) PRIMARY KEY,
    usuario_id VARCHAR(36) NOT NULL,
    rancho_id VARCHAR(36) NOT NULL,
    rol VARCHAR(50) NOT NULL, -- propietario, socio, colaborador
    tipo_colaborador_id VARCHAR(36),
    estado VARCHAR(50) DEFAULT 'activo',
    fecha_alta TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    fecha_creacion TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    actualizado_en TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    actualizado_por VARCHAR(36),
    eliminado BOOLEAN DEFAULT FALSE,
    CONSTRAINT fk_membresia_usuario FOREIGN KEY (usuario_id) REFERENCES usuario(id),
    CONSTRAINT fk_membresia_rancho FOREIGN KEY (rancho_id) REFERENCES rancho(id),
    CONSTRAINT fk_membresia_tipo_colaborador FOREIGN KEY (tipo_colaborador_id) REFERENCES tipo_colaborador(id)
);

-- 8. Tabla PermisoTipo (Permisos de ver/editar por módulo a nivel de tipo de colaborador)
CREATE TABLE permiso_tipo (
    id VARCHAR(36) PRIMARY KEY,
    tipo_colaborador_id VARCHAR(36) NOT NULL,
    modulo_codigo VARCHAR(50) NOT NULL,
    puede_ver BOOLEAN DEFAULT FALSE,
    puede_editar BOOLEAN DEFAULT FALSE,
    fecha_creacion TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    actualizado_en TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    actualizado_por VARCHAR(36),
    eliminado BOOLEAN DEFAULT FALSE,
    CONSTRAINT fk_permiso_tipo_colaborador FOREIGN KEY (tipo_colaborador_id) REFERENCES tipo_colaborador(id),
    CONSTRAINT fk_permiso_tipo_modulo FOREIGN KEY (modulo_codigo) REFERENCES modulo(codigo)
);

-- 9. Tabla PermisoMembresía (Permisos específicos de ver/editar por módulo a nivel de membresía individual)
CREATE TABLE permiso_membresia (
    id VARCHAR(36) PRIMARY KEY,
    membresia_id VARCHAR(36) NOT NULL,
    modulo_codigo VARCHAR(50) NOT NULL,
    puede_ver BOOLEAN DEFAULT FALSE,
    puede_editar BOOLEAN DEFAULT FALSE,
    fecha_creacion TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    actualizado_en TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    actualizado_por VARCHAR(36),
    eliminado BOOLEAN DEFAULT FALSE,
    CONSTRAINT fk_permiso_membresia_membresia FOREIGN KEY (membresia_id) REFERENCES membresia(id),
    CONSTRAINT fk_permiso_membresia_modulo FOREIGN KEY (modulo_codigo) REFERENCES modulo(codigo)
);