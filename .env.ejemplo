# Copia este archivo como .env y completa con tus propios valores.
# El archivo .env real NUNCA se sube al repositorio (ya está en .gitignore).

# Base de datos
DB_USUARIO=ganado_usuario
DB_CONTRASENA=cambiar_esta_clave
DB_NOMBRE=gestion_ganado
DB_PUERTO=5432

# Cadena de conexión que usa el servidor / el ORM
DATABASE_URL=postgresql://ganado_usuario:cambiar_esta_clave@localhost:5432/gestion_ganado

# Servidor
PUERTO_SERVIDOR=3000


# Cliente. Lo usan los enlaces que van en los correos (HU-07, HU-09).
URL_CLIENTE=http://localhost:5173
 
# Correo (HU-07, HU-09, HU-17).
# Por ahora el unico transporte es "consola": el mensaje, con el enlace, se
# escribe en la consola del servidor y no se envia nada. Cuando el equipo
# decida como se manda el correo de verdad, se agrega el transporte nuevo en
# servidor/src/comun/servicio-correo.ts y se cambia esta variable.
# Para enviar de verdad: brevo. Ver DECISIONES.md, punto 18.
CORREO_TRANSPORTE=consola
# BREVO_API_KEY=
# CORREO_REMITENTE=tu.correo.confirmado@gmail.com
# CORREO_REMITENTE_NOMBRE=Sistema de Gestión de Ganado
 
# Usuario con el que trabaja el cliente mientras no exista el inicio de sesion
# (HU-08). Se cae solo cuando esa historia este lista.
USUARIO_DEMO_ID=a1000000-0000-4000-8000-000000000001