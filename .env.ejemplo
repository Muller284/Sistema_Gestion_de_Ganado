# Copia este archivo como .env y completa con tus propios valores.
# El archivo .env real NUNCA se sube al repositorio (ya está en .gitignore).

# Base de datos
DB_USUARIO=ganado_usuario
DB_CONTRASENA=cambiar_esta_clave
DB_NOMBRE=gestion_ganado
DB_PUERTO=5432

# Cadena de conexión que usa el servidor / el ORM
DATABASE_URL=postgresql://ganado_usuario:cambiar_esta_clave@localhost:5432/gestion_ganado

# Servidor
PUERTO_SERVIDOR=3000

# Cliente servido por Docker (docker compose up): http://localhost:8080
PUERTO_CLIENTE=8080

# Clave con la que se firman los tokens de sesion (HU-12). Si falta, el
# servidor usa DB_CONTRASENA, y si tampoco esta, una clave fija que esta en
# el codigo: sirve para desarrollo, pero cualquiera que lea el repositorio
# podria firmar tokens. Pon una frase larga y distinta en cada maquina.
JWT_SECRETO=cambiar_por_una_frase_larga_y_secreta

# Cliente. Lo usan los enlaces que van en los correos (HU-07, HU-09).
URL_CLIENTE=http://localhost:5173

# Correo (HU-07, HU-09, HU-17).
#   consola  el correo se escribe en la consola del servidor, no sale nada.
#            Es lo que usan las pruebas y la integracion continua.
#   brevo    se envia de verdad. Pasos en DECISIONES.md, puntos 18 y 30:
#            1. Crear cuenta gratis en brevo.com.
#            2. Senders, domains & dedicated IPs -> Senders -> Add a sender,
#               con tu correo, y confirmarlo con el codigo que llega.
#            3. SMTP & API -> API Keys -> Generate a new API key.
#            4. Completar las tres lineas de abajo y probar con:
#                 cd servidor && npm run probar:correo -- tu.correo@gmail.com
CORREO_TRANSPORTE=consola
# BREVO_API_KEY=xkeysib-...
# CORREO_REMITENTE=el.correo.que.confirmaste@gmail.com
# CORREO_REMITENTE_NOMBRE=Sistema de Gestión de Ganado

# Asistente con IA (fase 5). Habla el formato de chat de OpenAI, que aceptan
# Gemini y Groq: se cambia de proveedor con estas tres lineas, sin tocar
# codigo. Pasos para sacar la clave gratis en DECISIONES.md, punto 48.
#   Gemini (recomendado)  https://aistudio.google.com/apikey
#     ASISTENTE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     ASISTENTE_MODELO=gemini-3.5-flash-lite
#   Groq                  https://console.groq.com/keys
#     ASISTENTE_URL=https://api.groq.com/openai/v1
#     ASISTENTE_MODELO=openai/gpt-oss-120b
# Sin ASISTENTE_CLAVE el sistema funciona igual; el asistente avisa que no
# esta configurado. Para correr las pruebas del servidor usa el proveedor
# simulado: ASISTENTE_URL=http://localhost:4599/v1,
# ASISTENTE_VOZ_URL=http://localhost:4599/v1beta y ASISTENTE_CLAVE=prueba.
ASISTENTE_URL=https://generativelanguage.googleapis.com/v1beta/openai
ASISTENTE_MODELO=gemini-3.5-flash-lite
ASISTENTE_CLAVE=
# Consultas por usuario y por mes (RF-42).
ASISTENTE_CONSULTAS_MES=30
# Cuanto piensa el modelo antes de responder: low (por defecto), medium o high.
# «ninguno» para no mandarlo, si un proveedor no lo acepta.
ASISTENTE_ESFUERZO=low
# Voz (DECISIONES.md, punto 49): preguntar hablando y escuchar la respuesta,
# con la misma clave de Gemini. Con Groq no hay voz. «ninguno» la apaga.
ASISTENTE_VOZ_MODELO=gemini-3.8-flash-lite-tts
# Voces de Gemini: Kore, Puck, Charon, Aoede, Leda, Orus...
ASISTENTE_VOZ_NOMBRE=Kore

# Entrar con el id de la cuenta, sin contraseña (la barra de demostración).
# En el servidor publicado va en «no» (DECISIONES.md, punto 52).
# PERMITIR_DEMOSTRACION=no

# Usuario con el que trabaja el cliente mientras no exista el inicio de sesion
# (HU-08). Se cae solo cuando esa historia este lista.
USUARIO_DEMO_ID=a1000000-0000-4000-8000-000000000001
